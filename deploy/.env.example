# deploy/.env 로 복사해서 채워요. .env는 Git에 올라가지 않아요.

# 사이트 주소 (https:// 없이). 이 주소의 DNS가 서버 IP를 가리켜야 HTTPS 인증서가 나와요.
DOMAIN=memoir.example.com

# DB 패스워드: 길고 무작위로. 예) openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 패스워드 찾기 메일 (Gmail 앱 비밀번호)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

# 로그인 캡차 (Cloudflare Turnstile). 비워 두면 테스트 키(누구나 통과)를 써요.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

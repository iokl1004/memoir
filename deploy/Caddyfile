# DOMAIN(.env)으로 오는 요청을 HTTPS로 받아 앱(app:8080)에 넘겨요. 인증서는 Caddy가 자동으로 받고 갱신해요.
# X-Forwarded-For/Proto를 붙여 넘기니, 앱은 진짜 접속 주소와 HTTPS 여부를 알아요.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 파일 이름에 해시가 붙은 화면 파일은 바뀌지 않으니 오래 둬요. (index.html은 늘 새로 받아요)
	@hashed path_regexp ^/assets/index-[A-Za-z0-9_-]+\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}
